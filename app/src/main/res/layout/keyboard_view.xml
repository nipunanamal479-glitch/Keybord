<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp">

        <Button
            android:id="@+id/btn_cipher"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="🔐 CIPHER"
            android:textColor="#FFFFFF"
            android:background="@drawable/keyboard_key_bg" />

        <Button
            android:id="@+id/btn_clip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="📋 CLIP"
            android:textColor="#FFFFFF"
            android:background="@drawable/keyboard_key_bg" />

        <Button
            android:id="@+id/btn_emoji"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="😀"
            android:textColor="#FFFFFF"
            android:background="@drawable/keyboard_key_bg" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cipher_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="5dp"
        android:alpha="0">

        <Button
            android:id="@+id/btn_encode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="🔐 ENCODE"
            android:textColor="#FFFFFF"
            android:background="@drawable/keyboard_key_bg" />

        <Button
            android:id="@+id/btn_decode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="🔓 DECODE"
            android:textColor="#FFFFFF"
            android:background="@drawable/keyboard_key_bg" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/emoji_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_marginBottom="5dp"
        android:alpha="0">

        <LinearLayout
            android:id="@+id/emoji_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keyBackground="@drawable/keyboard_key_bg"
        android:keyTextColor="#FFFFFF" />

</LinearLayout>
